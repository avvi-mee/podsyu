# Copy to .env to override defaults. Most settings can also be changed in the dashboard (Settings page).
# Never commit .env or data/secrets/ - they contain local configuration and OAuth files.

# Backend port (frontend expects 8000 unless NEXT_PUBLIC_API_URL is set in frontend/.env.local)
PSF_API_PORT=8000
# Dashboard port (change if another app already uses 3000)
PSF_FRONTEND_PORT=3000
# Where projects, database and logs live (default: ./data)
# PSF_DATA_DIR=D:\ShortsData
# Where finished shorts are written (default: ./data/exports)
# PSF_OUTPUT_DIR=D:\Shorts

# AI defaults
WHISPER_MODEL=small
WHISPER_DEVICE=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

PSF_TIMEZONE=Asia/Kolkata
# ASMR Cutting Studio folder (Blender knife-cutting videos); default D:\asmr cutting
# ASMR_CUTTING_DIR=D:\asmr cutting
# Must exactly match the "Authorized redirect URI" of your Google OAuth client
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
